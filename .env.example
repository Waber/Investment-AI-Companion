DATABASE_URL=postgresql://username:password@localhost:5432/investment_ai
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=

OPENAI_API_KEY=
NEWS_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Off unless you need /api/v1/test-config. The code default is also false.
DEBUG=False
# Required. At least 32 characters. A known placeholder is rejected
# in any case. Generate a value and paste it here (that command
# prints 43 characters):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# ALLOWED_HOSTS is enforced, so a request with any other Host gets 400 Invalid host header.
LOG_LEVEL=INFO
# Market-data collector behind fetch-company: yahoo (live Yahoo Finance,
# the default) or fake (offline, synthetic demo data).
DATA_COLLECTOR=yahoo
# In-process cache, rate limit and retry for the live (yahoo) collector.
# The fake collector is not wrapped. Each value has to be inside the
# range checked at startup (app/core/config.py).
# How long a successful fetch stays cached, in seconds (1 to 86400).
COLLECTOR_CACHE_TTL_SECONDS=300
# Upstream calls in any 60-second window (1 to 120). Cache hits do not
# count. 30 is the default so a normal session does not hammer Yahoo.
COLLECTOR_RATE_LIMIT_PER_MINUTE=30
# Longest a request may block waiting for a free slot, in seconds
# (0 to 60). The default is 5 so one call cannot freeze the API.
# 0 refuses immediately when any wait is needed. A longer wait fails
# with a provider error and does not count as an upstream call.
COLLECTOR_RATE_LIMIT_MAX_WAIT_SECONDS=5
# Budget for every sleep in one collector call, in seconds (1 to 120).
# That is the rate-limit waits plus the retry backoff. The default is
# 15. A sleep that would pass it fails the call instead. The upstream
# request itself is not cancelled.
COLLECTOR_TOTAL_DEADLINE_SECONDS=15
# Extra attempts after the first when Yahoo rate-limits the call or the
# connection fails (1 to 5). 2 means three calls, then a provider error.
COLLECTOR_MAX_RETRIES=2
# Full-jitter backoff. Each wait is random between 0 and
# min(max, base * 2^attempt) seconds. base is above 0 and at most 60.
# max is above 0, at most 120, and at least base.
COLLECTOR_BACKOFF_BASE_SECONDS=0.5
COLLECTOR_BACKOFF_MAX_SECONDS=8
# Comma-separated http(s) origins. A JSON list is also accepted.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
